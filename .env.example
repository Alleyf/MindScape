# Resource configuration has been migrated to MD files:
#   - content/config/resources.md    (7 resource categories)
#   - content/config/learning-routes.md  (3 learning routes)
# Edit these files directly instead of using env vars.

VITE_MICROLINK_API_URL=https://api.microlink.io/?url=
VITE_FAVICON_YANDEX_URL=https://favicon.yandex.net/favicon/

# AI Configuration (OpenAI compatible API)
# Get your API key from: https://platform.openai.com/api-keys
VITE_CLAUDE_API_KEY=

# AI API Base URL (OpenAI format: /v1/chat/completions)
# Examples:
#   https://api.openai.com/v1          - OpenAI
#   https://api.groq.com/openai/v1    - Groq
VITE_AI_API_BASE_URL=

# AI Model
# Examples: gpt-4o, gpt-4o-mini, gpt-3.5-turbo (OpenAI)
#           llama-3.1-70b-versatile (Groq)
VITE_AI_MODEL=
