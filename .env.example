# Resource configuration — copy values from .env and customize
# Use .env.local for overrides (not git-tracked)
#
# Full data override (JSON string):
#   VITE_RESOURCE_CATEGORIES='[...]'
#   VITE_LEARNING_ROUTES='[...]'
#
# URL service overrides:
#   VITE_MICROLINK_API_URL=https://api.microlink.io/?url=
#   VITE_FAVICON_YANDEX_URL=https://favicon.yandex.net/favicon/

# AI Configuration (Claude API)
# Get your API key from: https://console.anthropic.com/settings/keys
VITE_CLAUDE_API_KEY=

# AI API Base URL (default: https://api.anthropic.com/v1)
# For compatible APIs like Groq, Azure, etc.
VITE_AI_API_BASE_URL=

# AI Model (default: claude-sonnet-4-20250514)
# Options: claude-sonnet-4-20250514, claude-haiku-4-20250514, etc.
VITE_AI_MODEL=
